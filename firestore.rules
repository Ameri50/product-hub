rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Ajusta este correo si agregas más administradores ---
    // Debe coincidir con ADMIN_EMAILS en src/lib/admin.ts
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in [
          'joshuarojas432@gmail.com',
          'promo2026@outlook.com',
          'yo@gmail.com'
        ];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Catálogo: lectura pública (lo consume la app iOS y la web sin
    // login). Creación: cualquier usuario autenticado — la app iOS sube
    // productos con la sesión del admin de la app (UI restringida a admins,
    // ver adminEmails en userManager.swift). Edición/borrado: solo admin web.
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Perfiles de usuario: cada usuario solo puede leer/escribir el suyo.
    // El admin puede leer/escribir cualquiera (panel de "Usuarios").
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Pedidos / reservaciones: cada usuario autenticado crea y administra
    // solo los suyos (campo userUid). El admin del panel web puede leer y
    // modificar todos para gestionar el historial.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.userUid == request.auth.uid &&
          request.resource.data.userUid == resource.data.userUid);
    }

    // Todo lo demás: cerrado por defecto, solo admin.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
