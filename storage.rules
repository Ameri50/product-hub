rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in [
          'joshuarojas432@gmail.com',
          'promo2026@outlook.com',
          'yo@gmail.com'
        ];
    }

    // Imágenes de productos: lectura pública (se muestran en la app y
    // en la web). Escritura con cualquier sesión autenticada — la app iOS
    // sube la foto del producto nuevo antes de crear el documento (su UI
    // de subida solo la ve el admin). Límite de 10MB por archivo.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    // Todo lo demás: cerrado por defecto, solo admin.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
